# Shell scripts must be LF everywhere: a CRLF shebang makes Linux exec
# fail with "bad interpreter: /usr/bin/env bash\r", and all six deploy/
# backup scripts were committed CRLF (never executed by CI, so nothing
# caught it). `eol=lf` forces LF on checkout regardless of the developer's
# autocrlf setting; tests/test_shell_script_contracts.py enforces both the
# file bytes and `bash -n` syntax.
*.sh text eol=lf

# Node scripts with a shebang (frontend/scripts/*.mjs) fail the same way: Node cannot
# parse `#!/usr/bin/env node` and the whole vitest suite that imports them dies
# on a Windows checkout (roadmap unit 1).
*.mjs text eol=lf

# GnuCOBOL (Berkeley DB) INDEXED file images used as test evidence: raw
# bytes, never line-ending converted (tests/test_indexed_record_comparison.py).
tests/data/indexed_bdb/*.DAT binary
tests/data/relative/*.DAT binary

# sourced by bash (start-production.sh): a CRLF checkout broke `source` (staging run, 2026-11-11)
.env*.example text eol=lf
