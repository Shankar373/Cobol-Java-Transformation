# OCESQL + PostgreSQL oracle for embedded SQL (roadmap unit 12).
# Same immutable base and compiler as Dockerfile.gnucobol, plus:
#   * Open-COBOL-ESQL (OCESQL) v1.4, pinned by commit, built against GnuCOBOL 3.1.2;
#   * PostgreSQL 14 (pinned apt version) started inside the container for each test run.
# The oracle runs the COBOL program through the OCESQL precompiler and libpq against a seeded
# database; the generated JDBC program must match its stdout and final database state.
FROM ubuntu:22.04@sha256:5ec03bb3441e8b0bf3b4f9cd4629a1ae763010dc3035bb8da3ae6cf026486401

ENV DEBIAN_FRONTEND=noninteractive
# Optional apt mirror, used ONLY by scripts/ci/build-image.sh when the runner cannot resolve archive.ubuntu.com
# (GitHub runner DNS outage, 2026-11-11: the runners could not resolve any ubuntu.com host; mirrors.edge.kernel.org serves the same archive). Same Ubuntu archive content: the pinned package versions below and apt's
# signature verification are unchanged; empty (the default) leaves the base image's sources untouched.
ARG APT_MIRROR=""
RUN if [ -n "$APT_MIRROR" ]; then         sed -i -E "s#https?://(archive|security)\.ubuntu\.com#http://${APT_MIRROR}#g" /etc/apt/sources.list;     fi
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        gnucobol3=3.1.2-5 \
        libcob4=3.1.2-5 \
        libcob4-dev=3.1.2-5 \
        libgmp-dev \
        libdb-dev \
        libncurses-dev \
        ca-certificates \
        git \
        build-essential \
        bison \
        flex \
        autoconf \
        automake \
        libtool \
        pkgconf \
        libpq-dev=14.24-0ubuntu0.22.04.1 \
        postgresql-14=14.24-0ubuntu0.22.04.1 \
        postgresql-client-14=14.24-0ubuntu0.22.04.1 && \
    rm -rf /var/lib/apt/lists/*

# OCESQL v1.4, pinned by commit (a moved tag cannot change the oracle).
ARG OCESQL_COMMIT=14591d82b6423ed76540ced70f1d4752d31882f3
RUN git clone -q https://github.com/opensourcecobol/Open-COBOL-ESQL.git /tmp/ocesql && \
    cd /tmp/ocesql && git checkout -q "$OCESQL_COMMIT" && \
    test "$(git rev-parse HEAD)" = "$OCESQL_COMMIT" && \
    autoreconf -fi >/dev/null 2>&1 && \
    ./configure --prefix=/usr/local >/dev/null && make -j2 >/dev/null && make install >/dev/null && \
    ldconfig && cd / && rm -rf /tmp/ocesql

# Temurin 21 (the certified Java major) and the PostgreSQL JDBC driver, both verified against
# their publishers' SHA-256 before use, so generated JDBC code runs in the same image and against
# the same server as the OCESQL reference.
ARG TEMURIN_URL=https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.5%2B11/OpenJDK21U-jdk_x64_linux_hotspot_21.0.5_11.tar.gz
ARG TEMURIN_SHA256=3c654d98404c073b8a7e66bffb27f4ae3e7ede47d13284c132d40a83144bfd8c
ARG PGJDBC_URL=https://repo1.maven.org/maven2/org/postgresql/postgresql/42.7.4/postgresql-42.7.4.jar
ARG PGJDBC_SHA256=188976721ead8e8627eb6d8389d500dccc0c9bebd885268a3047180274a6031e
RUN apt-get update -qq && apt-get install -y --no-install-recommends curl &&     curl -sSfL -o /tmp/jdk.tgz "$TEMURIN_URL" &&     echo "$TEMURIN_SHA256  /tmp/jdk.tgz" | sha256sum -c - &&     mkdir -p /opt/jdk && tar -xzf /tmp/jdk.tgz -C /opt/jdk --strip-components=1 &&     mkdir -p /opt/jdbc &&     curl -sSfL -o /opt/jdbc/postgresql.jar "$PGJDBC_URL" &&     echo "$PGJDBC_SHA256  /opt/jdbc/postgresql.jar" | sha256sum -c - &&     rm -f /tmp/jdk.tgz && apt-get purge -y curl && apt-get autoremove -y -qq &&     rm -rf /var/lib/apt/lists/*

# Smoke-tests: the oracle compiler, the precompiler and the server are exactly what is declared.
RUN cobc --version | head -1 | grep -qx 'cobc (GnuCOBOL) 3.1.2.0' && \
    test -x /usr/local/bin/ocesql && \
    /usr/lib/postgresql/14/bin/postgres --version | grep -q 'PostgreSQL) 14\.' && \
    /opt/jdk/bin/java -version 2>&1 | head -1 | grep -q '"21\.' && \
    test -s /opt/jdbc/postgresql.jar

# The hardened runner (engine/execution/container_hardening.py) runs every container as
# 10001:10001 with all capabilities dropped; PostgreSQL's initdb needs that user to exist.
RUN groupadd -g 10001 runner && useradd -u 10001 -g 10001 -m runner

ENV PATH=/opt/jdk/bin:/usr/lib/postgresql/14/bin:$PATH
ENV JAVA_HOME=/opt/jdk
WORKDIR /workspace
