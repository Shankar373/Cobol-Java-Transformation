# Pinned by digest 2026-10-08 (workstream-5 supply-chain hardening).
# Same tag content as maven:3.9-eclipse-temurin-21; digest makes it immutable.
# Spring Boot precache version (3.2.5) is intentionally NOT bumped here:
# the generator (engine/transformation/*, engine/modernization/*) emits
# spring-boot-starter-parent 3.2.5, so changing it requires app-source
# changes that are out of scope. See docs/supply-chain/DEPENDENCY_AUDIT.md.
FROM maven:3.9-eclipse-temurin-21@sha256:99e61abcff91a9b1333463bd8451fb18495d6eba9250ac66a338b518f8278320

# Pre-cache Spring Boot dependencies for offline build.
# The precache pom must list every starter any generated lane emits:
# the COBOL lanes emit spring-boot-starter, the JCL lane emits
# spring-boot-starter-batch (BL-071 — the JCL project could not compile
# offline before it was added here).
RUN mkdir -p /tmp/precache/src/main/java/precache && \
    echo '<project><modelVersion>4.0.0</modelVersion><parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>3.2.5</version></parent><groupId>precache</groupId><artifactId>precache</artifactId><version>0.0.1</version><properties><java.version>21</java.version></properties><dependencies><dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter</artifactId></dependency><dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-batch</artifactId></dependency></dependencies><build><plugins><plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin></plugins></build></project>' > /tmp/precache/pom.xml && \
    echo 'package precache;public class Precache{public static void main(String[] a){}}' > /tmp/precache/src/main/java/precache/Precache.java && \
    cd /tmp/precache && mvn -B -DskipTests dependency:go-offline package && \
    rm -rf /tmp/precache && \
    chmod 755 /root && chmod -R a+rX /root/.m2

# P0 non-root execution (2026-10-24): the workload containers run as
# --user 10001:10001 (engine.execution.container_hardening).  /root is
# 0700 in the base image, so the offline repository above would be
# unreadable to the build identity; publishing it world-readable (dirs
# a+rX, files a+r) lets the non-root build read its precache while every
# write target stays outside /root (tmpfs target/, host-mounted output/).
# Done inside the precache RUN so no extra layer duplicates the repo.
ENV MAVEN_OPTS="-Dmaven.repo.local=/root/.m2/repository"
