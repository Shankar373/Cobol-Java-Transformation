FROM maven:3.9-eclipse-temurin-21

# Pre-cache Spring Boot dependencies for offline build
RUN mkdir -p /tmp/precache/src/main/java/precache && \
    echo '<project><modelVersion>4.0.0</modelVersion><parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>3.2.5</version></parent><groupId>precache</groupId><artifactId>precache</artifactId><version>0.0.1</version><properties><java.version>21</java.version></properties><dependencies><dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter</artifactId></dependency></dependencies><build><plugins><plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin></plugins></build></project>' > /tmp/precache/pom.xml && \
    echo 'package precache;public class Precache{public static void main(String[] a){}}' > /tmp/precache/src/main/java/precache/Precache.java && \
    cd /tmp/precache && mvn -B -DskipTests dependency:go-offline package && \
    rm -rf /tmp/precache

ENV MAVEN_OPTS="-Dmaven.repo.local=/root/.m2/repository"
