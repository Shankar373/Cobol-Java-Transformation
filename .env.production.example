# Production environment for the SystemaOps control plane.
# Copy to .env.production (NEVER commit the filled copy):
#   cp .env.production.example .env.production
# Reference: docs/deployment/ENVIRONMENT.md

# --- REQUIRED: API authentication -------------------------------------------
# Without this, every route except /health is unauthenticated (the app's
# documented development default). Production MUST set a long random token,
# e.g. from:  python -c "import secrets; print(secrets.token_urlsafe(48))"
CONTROL_PLANE_API_TOKEN=

# --- REQUIRED: TLS material paths (host paths mounted into nginx) -----------
TLS_CERT_PATH=./deployment/tls/fullchain.pem
TLS_KEY_PATH=./deployment/tls/privkey.pem
HTTPS_PORT=443

# --- REQUIRED for static UI: prebuilt frontend -------------------------------
# Build with `npm run build` in frontend/ (CI already does this).
FRONTEND_DIST_PATH=./frontend/dist

# --- Upload budgets (must stay <= nginx client_max_body_size) ---------------
CONTROL_PLANE_MAX_REQUEST_BYTES=52428800
CONTROL_PLANE_MAX_FILE_BYTES=10485760
CONTROL_PLANE_MAX_UPLOAD_FILES=1000

# --- Concurrency (in-process daemon workers; SQLite single-writer) -----------
# Raising this does not add HA; restarts still fail interrupted runs.
CONTROL_PLANE_MAX_CONCURRENT_JOBS=4

# --- CORS: same-origin by default --------------------------------------------
# Comma-separated allowlist, e.g. "https://app.example.com".
# Leave empty unless the UI is served from a different origin.
CONTROL_PLANE_ALLOWED_ORIGINS=

# --- Release pinning ----------------------------------------------------------
IMAGE_TAG=production
