IDENTIFICATION DIVISION.
       PROGRAM-ID. START-KEY-STATUS.
       AUTHOR. VALIDATION-PLATFORM.

       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT IDX-FILE ASSIGN TO "START.DAT"
               ORGANIZATION IS INDEXED
               RECORD KEY IS IDX-KEY
               ACCESS MODE IS DYNAMIC
               FILE STATUS IS WS-FILE-STATUS.

       DATA DIVISION.
       FILE SECTION.
       FD  IDX-FILE.
       01  IDX-REC.
           05  IDX-KEY             PIC X(4).
           05  IDX-DATA            PIC X(20).

       WORKING-STORAGE SECTION.
       01  WS-FILE-STATUS      PIC X(2) VALUE "00".

       PROCEDURE DIVISION.
       MAIN-LOGIC.
           DISPLAY "START/INVALID KEY/FILE STATUS DEMO STARTED".

           OPEN OUTPUT IDX-FILE.
           DISPLAY "OPEN OUTPUT STATUS=" WS-FILE-STATUS.

           MOVE "K001" TO IDX-KEY.
           MOVE "RECORD-ONE----------" TO IDX-DATA.
           WRITE IDX-REC.
           DISPLAY "WRITE K001 STATUS=" WS-FILE-STATUS.

           MOVE "K002" TO IDX-KEY.
           MOVE "RECORD-TWO---------" TO IDX-DATA.
           WRITE IDX-REC.
           DISPLAY "WRITE K002 STATUS=" WS-FILE-STATUS.

           MOVE "K003" TO IDX-KEY.
           MOVE "RECORD-THREE--------" TO IDX-DATA.
           WRITE IDX-REC.
           DISPLAY "WRITE K003 STATUS=" WS-FILE-STATUS.

           CLOSE IDX-FILE.
           DISPLAY "CLOSE STATUS=" WS-FILE-STATUS.

           OPEN I-O IDX-FILE.
           DISPLAY "OPEN I-O STATUS=" WS-FILE-STATUS.

           MOVE "K002" TO IDX-KEY.
           START IDX-FILE KEY = IDX-KEY.
           DISPLAY "START = K002 STATUS=" WS-FILE-STATUS.

           READ IDX-FILE.
           DISPLAY "READ AFTER START = KEY=" IDX-KEY " STATUS=" WS-FILE-STATUS.

           MOVE "K001" TO IDX-KEY.
           START IDX-FILE KEY > IDX-KEY.
           DISPLAY "START > K001 STATUS=" WS-FILE-STATUS.

           READ IDX-FILE.
           DISPLAY "READ AFTER START > KEY=" IDX-KEY " STATUS=" WS-FILE-STATUS.

           MOVE "K999" TO IDX-KEY.
           START IDX-FILE KEY = IDX-KEY
               INVALID KEY
                   DISPLAY "START = K999 INVALID KEY STATUS=" WS-FILE-STATUS
           END-START.

           MOVE "K001" TO IDX-KEY.
           MOVE "DUPLICATE-KEY-------" TO IDX-DATA.
           WRITE IDX-REC
               INVALID KEY
                   DISPLAY "WRITE DUPLICATE K001 INVALID KEY STATUS=" WS-FILE-STATUS
           END-WRITE.

           MOVE "K999" TO IDX-KEY.
           READ IDX-FILE
               INVALID KEY
                   DISPLAY "READ K999 INVALID KEY STATUS=" WS-FILE-STATUS
           END-READ.

           MOVE "K002" TO IDX-KEY.
           DELETE IDX-FILE RECORD
               INVALID KEY
                   DISPLAY "DELETE K002 INVALID KEY STATUS=" WS-FILE-STATUS
           END-DELETE.

           MOVE "K002" TO IDX-KEY.
           DELETE IDX-FILE RECORD
               INVALID KEY
                   DISPLAY "DELETE K002 AGAIN INVALID KEY STATUS=" WS-FILE-STATUS
           END-DELETE.

           CLOSE IDX-FILE.
           DISPLAY "FINAL CLOSE STATUS=" WS-FILE-STATUS.

           STOP RUN.
