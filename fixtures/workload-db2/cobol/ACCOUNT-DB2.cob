002700
002800 READ-ACCOUNT.
002900     MOVE 1 TO WS-ACCOUNT-ID.
003000     EXEC SQL
003100         SELECT CUSTOMER_NAME, BALANCE
003200           INTO :WS-ACCOUNT-NAME, :WS-BALANCE:WS-BALANCE-IND
003300           FROM ACCOUNT
003400          WHERE ACCOUNT_ID = :WS-ACCOUNT-ID
003500     END-EXEC.
003600     IF SQLCODE = 100
003700         DISPLAY "ACCOUNT-DB2: NO DATA"
003800     ELSE
003900         IF SQLCODE < 0
004000             DISPLAY "ACCOUNT-DB2: SQL ERROR " SQLCODE
004100         END-IF
004200     END-IF.
004300
004400 ADD-ACCOUNT.
004500     MOVE 6 TO WS-ACCOUNT-ID.
004600     MOVE "Frank" TO WS-ACCOUNT-NAME.
004700     EXEC SQL
004800         INSERT INTO ACCOUNT (ACCOUNT_ID, CUSTOMER_NAME, BALANCE)
004900         VALUES (:WS-ACCOUNT-ID, :WS-ACCOUNT-NAME, 0.00)
005000     END-EXEC.
005100     IF SQLCODE < 0
005200         DISPLAY "ACCOUNT-DB2: INSERT FAILED " SQLCODE
005300     END-IF.
005400
005500 ADJUST-BALANCE.
005600     MOVE 2 TO WS-ACCOUNT-ID.
005700     MOVE 50.00 TO WS-BALANCE.
005800     EXEC SQL
005900         UPDATE ACCOUNT
005900            SET BALANCE = BALANCE + :WS-BALANCE
006000          WHERE ACCOUNT_ID = :WS-ACCOUNT-ID
006100     END-EXEC.
006200     IF SQLCODE < 0
006300         DISPLAY "ACCOUNT-DB2: UPDATE FAILED " SQLCODE
006400     END-IF.
006500
006600 DELETE-ACCOUNT.
006700     MOVE 4 TO WS-ACCOUNT-ID.
006800     EXEC SQL
006900         DELETE FROM ACCOUNT
007000          WHERE ACCOUNT_ID = :WS-ACCOUNT-ID
007100     END-EXEC.
007200     IF SQLCODE < 0
007300         DISPLAY "ACCOUNT-DB2: DELETE FAILED " SQLCODE
007400     END-IF.
007500     EXEC SQL
007600         COMMIT
007700     END-EXEC.
007800
007900 SCAN-ACCOUNTS.
008000     EXEC SQL
008100         DECLARE C-ACCTS CURSOR FOR
008200             SELECT ACCOUNT_ID, CUSTOMER_NAME
008300               FROM ACCOUNT
008400              ORDER BY ACCOUNT_ID
008500     END-EXEC.
008600     EXEC SQL
008700         OPEN C-ACCTS
008800     END-EXEC.
008900     PERFORM UNTIL SQLCODE = 100
009000         EXEC SQL
009100             FETCH C-ACCTS INTO :WS-ACCOUNT-ID, :WS-ACCOUNT-NAME
009200         END-EXEC
009300         IF SQLCODE = 0
009400             DISPLAY "ACCOUNT-DB2: SCANNED " WS-ACCOUNT-ID
009500         END-IF
009600     END-PERFORM.
009700     EXEC SQL
009800         CLOSE C-ACCTS
009900     END-EXEC.
010000     EXEC SQL
010100         COMMIT
010200     END-EXEC.
010300
010400 ROLLBACK-WORK.
010500     EXEC SQL
010600         ROLLBACK
010700     END-EXEC.
010800
010900 END PROGRAM ACCOUNT-DB2.