# Pinned by digest 2026-10-08 (workstream-5 supply-chain hardening).
# Same tag content as ubuntu:22.04; digest makes it immutable.
FROM ubuntu:22.04@sha256:5ec03bb3441e8b0bf3b4f9cd4629a1ae763010dc3035bb8da3ae6cf026486401

# Install GnuCOBOL 3.1.2 — the project's V1 oracle runtime.
# Package versions are pinned (audit V5): the unversioned `gnucobol`
# metapackage let a rebuild pick up a different compiler while evidence kept
# naming 3.1.2.0. The engine also checks `cobc --version` before every run.
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        gnucobol3=3.1.2-5 \
        libcob4=3.1.2-5 \
        libcob4-dev=3.1.2-5 \
        libgmp-dev \
        libdb-dev \
        libncurses-dev \
        ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Smoke-test: the image must report exactly the declared oracle compiler.
RUN cobc --version | head -1 | grep -qx 'cobc (GnuCOBOL) 3.1.2.0'

WORKDIR /workspace
