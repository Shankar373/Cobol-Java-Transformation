       IDENTIFICATION DIVISION.
       PROGRAM-ID. BILLRUN.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT CUST-FILE ASSIGN TO CUSTIN ORGANIZATION IS INDEXED
               ACCESS MODE IS SEQUENTIAL RECORD KEY IS CUST-ID.
           SELECT INV-FILE ASSIGN TO INVOUT.
       DATA DIVISION.
       FILE SECTION.
       FD  CUST-FILE.
           COPY CUSTREC.
       FD  INV-FILE.
           COPY TRANREC REPLACING ==:TR:== BY ==INV==.
       WORKING-STORAGE SECTION.
           COPY RATES.
           COPY ERRCODES.
       01  T PIC S9(9)V99.
       PROCEDURE DIVISION.
       BILL-MAIN.
           OPEN INPUT CUST-FILE OUTPUT INV-FILE.
           PERFORM NEXT-CUST UNTIL CUST-ID = 0.
           PERFORM 3 TIMES
               PERFORM WRITE-INV
           END-PERFORM.
           GO TO BILL-END.
       NEXT-CUST.
           READ CUST-FILE.
       WRITE-INV.
           WRITE INV-REC.
           EXEC SQL INSERT INTO BILL.INVOICE VALUES (1) END-EXEC.
           EXEC SQL SELECT TOTAL INTO :T FROM BILL.INVOICE END-EXEC.
       BILL-END.
           CLOSE CUST-FILE INV-FILE.
           GOBACK.
