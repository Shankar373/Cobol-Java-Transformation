       IDENTIFICATION DIVISION.
       PROGRAM-ID. ORDENTRY.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
           COPY CUSTREC.
           COPY ERRCODES.
       01  WS-PGM PIC X(8) VALUE 'ORDPRICE'.
       01  WS-DYN PIC X(8).
       PROCEDURE DIVISION.
           EXEC CICS RECEIVE MAP('ORDMAP') MAPSET('ORDSET') END-EXEC.
           EXEC CICS READ FILE('ORDFILE') INTO(CUST-REC) RIDFLD(CUST-ID) END-EXEC.
           EXEC CICS WRITE FILE('ORDLOG') FROM(CUST-REC) END-EXEC.
           EXEC CICS LINK PROGRAM('ORDPRICE') END-EXEC.
           CALL WS-PGM USING CUST-REC.
           CALL 'DYNLOOKUP' USING CUST-REC.
           CALL WS-DYN USING CUST-REC.
           EXEC CICS RETURN TRANSID('ORD1') END-EXEC.
