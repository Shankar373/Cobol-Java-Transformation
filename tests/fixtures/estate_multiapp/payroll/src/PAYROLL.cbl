       IDENTIFICATION DIVISION.
       PROGRAM-ID. PAYROLL.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT EMP-FILE ASSIGN TO EMPFILE
               ORGANIZATION IS INDEXED ACCESS MODE IS DYNAMIC
               RECORD KEY IS EMP-ID FILE STATUS IS WS-FS.
           SELECT PAY-FILE ASSIGN TO PAYFILE FILE STATUS IS WS-FS.
       DATA DIVISION.
       FILE SECTION.
       FD  EMP-FILE.
           COPY CUSTREC.
       FD  PAY-FILE.
           COPY TRANREC REPLACING ==:TR:== BY ==PAY==.
       WORKING-STORAGE SECTION.
           COPY PAYHDR REPLACING ==HDR== BY ==PAY==.
           COPY ERRCODES.
       01  WS-FS        PIC XX.
       01  WS-TOTAL     PIC S9(9)V99.
       01  N            PIC X(30).
           EXEC SQL INCLUDE SQLCA END-EXEC.
       PROCEDURE DIVISION.
       MAIN-PARA.
           OPEN I-O EMP-FILE OUTPUT PAY-FILE.
           PERFORM READ-EMP.
           PERFORM CALC-PAY THRU CALC-EXIT.
           GO TO FINISH-PARA.
       READ-EMP.
           READ EMP-FILE.
           MOVE CUST-NAME TO WS-FS.
       CALC-PAY.
           CALL 'PAYCALC' USING WS-TOTAL.
           EXEC SQL SELECT NAME INTO :N FROM HR.EMPLOYEE END-EXEC.
           EXEC SQL UPDATE HR.PAYSTUB SET GROSS = 0 END-EXEC.
           REWRITE CUST-REC.
           WRITE PAY-REC.
       CALC-EXIT.
           EXIT.
       FINISH-PARA.
           CLOSE EMP-FILE PAY-FILE.
           GOBACK.
