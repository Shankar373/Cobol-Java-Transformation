       IDENTIFICATION DIVISION.
       PROGRAM-ID. MAIN.
       AUTHOR. VALIDATION-PLATFORM.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-QTY             PIC 9(4) VALUE 3.
       01  WS-DISCOUNT        PIC 9(4) VALUE 10.
       01  WS-RESULT-A        PIC 9(4) VALUE 0.
       01  WS-RESULT-B        PIC 9(4) VALUE 0.
       01  WS-RESULT-C        PIC 9(4) VALUE 0.
       PROCEDURE DIVISION.
       MAIN-LOGIC.
           DISPLAY "SYSTEMAOPS-START".
           MOVE 42 TO WS-RESULT-A WS-RESULT-B WS-RESULT-C.
           DISPLAY "MULTI-MOVE-A=" WS-RESULT-A.
           DISPLAY "MULTI-MOVE-B=" WS-RESULT-B.
           DISPLAY "MULTI-MOVE-C=" WS-RESULT-C.
           SUBTRACT 10 FROM WS-RESULT-A.
           DISPLAY "SUBTRACT-INPLACE=" WS-RESULT-A.
           MULTIPLY 3 BY WS-RESULT-B.
           DISPLAY "MULTIPLY-INPLACE=" WS-RESULT-B.
           CALL "CALC".
           DISPLAY "SYSTEMAOPS-END".
           STOP RUN.
